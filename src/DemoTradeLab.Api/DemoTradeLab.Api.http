@DemoTradeLab.Api_HostAddress = http://localhost:5122

GET {{DemoTradeLab.Api_HostAddress}}/api/health
Accept: application/json

###

GET {{DemoTradeLab.Api_HostAddress}}/api/demo-profiles
Accept: application/json

###

# Copy an account ID from the response above before running these requests.
@DemoAccountId = 00000000-0000-0000-0000-000000000000
@ReservationId = 00000000-0000-0000-0000-000000000000
@OrderId = 00000000-0000-0000-0000-000000000000
@IdempotencyKey = replace-with-a-unique-value

GET {{DemoTradeLab.Api_HostAddress}}/api/demo-accounts/{{DemoAccountId}}/reservations
Accept: application/json

###

POST {{DemoTradeLab.Api_HostAddress}}/api/demo-accounts/{{DemoAccountId}}/reservations
Content-Type: application/json
Idempotency-Key: {{IdempotencyKey}}

{
  "amount": 80.00
}

###

GET {{DemoTradeLab.Api_HostAddress}}/api/demo-accounts/{{DemoAccountId}}/reservations/{{ReservationId}}
Accept: application/json

###

POST {{DemoTradeLab.Api_HostAddress}}/api/demo-accounts/{{DemoAccountId}}/reservations/{{ReservationId}}/release
Idempotency-Key: release-{{IdempotencyKey}}

###

POST {{DemoTradeLab.Api_HostAddress}}/api/demo-accounts/{{DemoAccountId}}/reservations/{{ReservationId}}/consume
Idempotency-Key: consume-{{IdempotencyKey}}

###

POST {{DemoTradeLab.Api_HostAddress}}/api/demo-accounts/{{DemoAccountId}}/orders
Content-Type: application/json

{
  "reservationId": "{{ReservationId}}"
}

###

GET {{DemoTradeLab.Api_HostAddress}}/api/demo-accounts/{{DemoAccountId}}/orders/{{OrderId}}
Accept: application/json

###

POST {{DemoTradeLab.Api_HostAddress}}/api/demo-accounts/{{DemoAccountId}}/orders/{{OrderId}}/complete

###

POST {{DemoTradeLab.Api_HostAddress}}/api/demo-accounts/{{DemoAccountId}}/orders/{{OrderId}}/fail

###

POST {{DemoTradeLab.Api_HostAddress}}/api/demo-accounts/{{DemoAccountId}}/orders/{{OrderId}}/compensate

###

GET {{DemoTradeLab.Api_HostAddress}}/api/demo-accounts/{{DemoAccountId}}/orders/{{OrderId}}/events
Accept: application/json

###

GET {{DemoTradeLab.Api_HostAddress}}/api/demo-accounts/{{DemoAccountId}}/orders/reconciliation
Accept: application/json

###

GET {{DemoTradeLab.Api_HostAddress}}/api/trades
Accept: application/json

###

GET {{DemoTradeLab.Api_HostAddress}}/api/trades?instrument=EUR%2FUSD&outcome=profitable&sortBy=realizedProfitLoss&sortDirection=descending
Accept: application/json

###

GET {{DemoTradeLab.Api_HostAddress}}/api/analytics/dashboard
Accept: application/json

###

GET {{DemoTradeLab.Api_HostAddress}}/api/analytics/instruments
Accept: application/json

###

GET {{DemoTradeLab.Api_HostAddress}}/api/analytics/profit-loss-timeline
Accept: application/json

###

POST {{DemoTradeLab.Api_HostAddress}}/api/trades
Content-Type: application/json

{
  "instrument": "EUR/USD",
  "direction": "buy",
  "openedAtUtc": "2026-08-04T10:00:00Z",
  "closedAtUtc": "2026-08-04T10:20:00Z",
  "openingPrice": 1.15,
  "closingPrice": 1.152,
  "quantity": 1000,
  "realizedProfitLoss": 2,
  "currency": "USD",
  "fees": null,
  "financingCosts": null
}

###
